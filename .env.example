# Fair Exchange AI Gateway - environment configuration
# Copy to .env for local development. Never commit a real .env file.

# --- Server ---
PORT=8787
NODE_ENV=development
LOG_LEVEL=info

# --- Gateway auth ---
# Comma-separated list of API keys applications must send as `x-api-key`.
# Leave empty in local development to run unauthenticated (a warning is logged).
# In production this MUST be set - the server refuses to boot with NODE_ENV=production and no keys.
GATEWAY_API_KEYS=

# --- Request limits ---
REQUEST_BODY_LIMIT_BYTES=131072
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=60
PROVIDER_TIMEOUT_MS=20000

# --- Response behavior ---
# Include provider/model/promptVersion in API responses. Useful in development;
# consider disabling in production if clients should not see routing decisions.
GATEWAY_EXPOSE_PROVIDER_INFO=true

# --- Privacy / telemetry ---
# Full prompt/input/output content is NEVER logged unless this is explicitly enabled.
# Operational metadata (provider, model, latency, token counts, success/failure) is
# always recorded regardless of this flag.
FAIR_EXCHANGE_LOG_FULL_CONTENT=false

# --- Mock provider (test/evaluation fixture, NOT a production provider) ---
# Mock is never part of any task's production route (see src/router/route-config.ts)
# and is never a fallback of last resort - if every real provider fails, a normal
# request fails with ALL_PROVIDERS_FAILED, on purpose. Set this to true only for
# local development when you explicitly want the gateway runnable end-to-end with
# zero provider credentials. Leave false (the default) everywhere else, including
# production. The benchmark harness can always target mock explicitly via
# `--models mock/...` regardless of this setting. See
# docs/adr/0004-mock-is-not-a-fallback.md.
ENABLE_MOCK_PROVIDER=false

# --- NVIDIA NIM (OpenAI-compatible API) ---
# First experimental/open-model provider. Get a key from https://build.nvidia.com
# NVIDIA has marked its FREE API Catalog tier deprecated - confirm current
# status against NVIDIA's own docs before depending on this route beyond
# development/benchmarking. See docs/production-limitations.md.
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# --- Anthropic ---
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
ANTHROPIC_VERSION=2023-06-01
