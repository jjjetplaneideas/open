# Copy this file to `.env` and fill in your key.
#
# Get a key at https://openrouter.ai/keys
# The default model (Dolphin Mistral 24B Venice Edition) has a free tier.
#
# If you leave this blank, the app still runs — users can paste their own
# key into the in-app Settings panel (bring-your-own-key / BYOK).
OPENROUTER_API_KEY=

# Optional overrides
PORT=3000
# Default model used when the client doesn't specify one.
DEFAULT_MODEL=cognitivecomputations/dolphin-mistral-24b-venice-edition:free
