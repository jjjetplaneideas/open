{
  "name": "fair-exchange-ai-gateway",
  "version": "0.1.0",
  "private": true,
  "description": "Provider-agnostic AI inference gateway for The Fair Exchange studio applications.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node --enable-source-maps dist/index.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src tests benchmark --ext .ts",
    "test": "vitest run tests/unit",
    "test:watch": "vitest tests/unit",
    "test:integration": "FAIR_EXCHANGE_RUN_LIVE_TESTS=1 vitest run tests/integration",
    "benchmark": "tsx benchmark/run-benchmark.ts"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.9.0",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^8.14.0",
    "@typescript-eslint/parser": "^8.14.0",
    "eslint": "^8.57.1",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
